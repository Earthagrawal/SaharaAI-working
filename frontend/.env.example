# .env.example for sahara-youth-mental-wellness frontend
# Copy to .env and fill in as needed. Do NOT commit secrets.

# Backend API base URL (e.g. http://localhost:8000)
VITE_BACKEND_URL=http://localhost:8000

# Enable frontend mock mode (true/false)
VITE_MOCK_MODE=true

# Sentry DSN (leave blank unless using Sentry)
VITE_SENTRY_DSN=

# App name (for UI display)
VITE_APP_NAME=Sahara Youth Mental Wellness

# Default language (optional, e.g. en)
VITE_DEFAULT_LANG=en

# Max recording seconds for mic (default 60)
VITE_RECORD_MAX_SECONDS=60
