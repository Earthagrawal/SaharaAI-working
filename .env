APP_ENV=development
MOCK_MODE=true

# Google Cloud (leave empty for mock mode)
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_MODEL=
VERTEX_EMBEDDING_MODEL=
MAX_OUTPUT_TOKENS=256

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_VECTOR_DIM=128
RETRIEVAL_TOP_K=3

# Caches
STT_CACHE_TTL_MIN=1440
TTS_CACHE_TTL_MIN=1440

# Context/session
LLM_CONTEXT_TURNS=5
SESSION_TTL_MIN=1440

# Observability
SENTRY_DSN=
PROMETHEUS_SCRAPE=true

# KB mount inside backend container
KB_PATH=/kb